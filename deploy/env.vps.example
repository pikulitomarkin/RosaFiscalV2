# Copie para a raiz do projeto na VPS:
#   cp deploy/env.vps.example .env
# NÃO commite o .env com valores reais.

# --- Postgres (docker-compose) ---
POSTGRES_DB=nfse
POSTGRES_USER=nfse
POSTGRES_PASSWORD=troque-por-senha-forte

# DATABASE_URL é montada pelo compose apontando para o serviço `db`.
# Se rodar Postgres fora do Docker, defina manualmente:
# DATABASE_URL=postgresql://nfse:SENHA@127.0.0.1:5432/nfse

# --- App ---
APP_NAME=NFS-e Automation System
DEBUG=False
SECRET_KEY=troque-por-chave-secreta-longa
LOG_LEVEL=INFO

# --- Auth fallback (bootstrap se a tabela usuarios ainda não existir) ---
ADMIN_USERNAME=admin
# Gere com:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
# No Docker Compose, escape cada $ do hash como $$ (senão o Compose come o valor)
ADMIN_PASSWORD_HASH=$$2b$$12$$substitua_pelo_hash_bcrypt

# --- IPM / Prefeitura Santa Rosa-RS ---
IPM_WEBSERVICE_URL=https://ws-santarosa.atende.net/?pg=rest&service=WNERestServiceNFSe
IPM_USUARIO=56169351000185
IPM_SENHA=sua_senha_ipm
IPM_AMBIENTE_TESTE=False

# --- Certificado A1 (opcional se já existir certificados/cert.pem e key.pem) ---
CERTIFICATE_PATH=certificados/cert.pem
CERTIFICATE_PASSWORD=
# Ou injete via Base64 (railway_init.py escreve os PEMs na subida):
# CERTIFICATE_CERT_PEM=
# CERTIFICATE_KEY_PEM=

# --- Nginx ---
HTTP_PORT=80
# HTTPS_PORT=443

# --- Persistência ---
# No compose: volume /app/data (equivalente ao volume Railway)
RAILWAY_VOLUME_MOUNT_PATH=/app/data
